# Karpenter EC2NodeClass (v1 API) — how nodes are built.
# Subnets and security groups are discovered by the tag the eks module applies
# (karpenter.sh/discovery = <cluster_name>), so no ids are hard-coded here.
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: aequor-default
spec:
  amiFamily: AL2023
  role: ${node_role_name}
  subnetSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${cluster_name}
  securityGroupSelectorTerms:
    - tags:
        karpenter.sh/discovery: ${cluster_name}
  amiSelectorTerms:
    - alias: al2023@latest
  metadataOptions:
    httpTokens: required          # IMDSv2 only
    httpPutResponseHopLimit: 1
  blockDeviceMappings:
    - deviceName: /dev/xvda
      ebs:
        volumeSize: 40Gi
        volumeType: gp3
        encrypted: true
        deleteOnTermination: true
  tags:
    aequor.io/managed-by: karpenter
